@model Night.ViewModels.CollectiveMemberViewModel
@using Night.Models
@using Night.Extensions

<article class="subscribed-member-card card h-100 border-0 shadow-sm">
    <div class="card-body d-flex flex-column p-4 text-center">
        @* Circular Profile Picture *@
        <div class="mb-3">
            <div class="position-relative d-inline-block">
                <img src="@(Model.ImageSmallUrl ?? Model.Image)" 
                     alt="@Model.Name" 
                     class="rounded-circle border border-2 border-primary shadow-sm"
                     width="100" 
                     height="100"
                     loading="lazy"
                     decoding="async"
                     style="object-fit: cover;" />
                <span class="position-absolute bottom-0 end-0 badge bg-primary rounded-circle p-2" title="Subscribed Member">
                    <i class="bi bi-star-fill"></i>
                </span>
            </div>
        </div>

        <h2 class="h5 card-title mb-1 fw-bold">@Model.Name</h2>

        @if (!string.IsNullOrEmpty(Model.Position))
        {
            <p class="text-muted small mb-3">
                <i class="bi bi-briefcase"></i>
                @Model.Position
            </p>
        }

        @if (Model.FeaturedGame is not null)
        {
            <div class="mt-auto pt-3 border-top">
                <p class="text-muted small mb-3">
                    <i class="bi bi-controller"></i> Featured Work
                </p>

                @* Featured Game Display Card *@
                <div class="card border-0 bg-light shadow-sm">
                    <div class="row g-0 h-100">
                        <div class="col-5">
                            <img src="@(Model.FeaturedGame.ImageSmallUrl ?? Model.FeaturedGame.Image)" 
                                 alt="@Model.FeaturedGame.Title" 
                                 class="img-fluid rounded-start h-100"
                                 loading="lazy"
                                 decoding="async"
                                 style="height: 120px; width: 100%; object-fit: cover;" />
                        </div>
                        <div class="col-7 d-flex flex-column">
                            <div class="card-body p-3 d-flex flex-column">
                                <h6 class="card-title mb-2 fw-bold" title="@Model.FeaturedGame.Title">
                                    @(Model.FeaturedGame.Title.Length > 20 ? Model.FeaturedGame.Title.Substring(0, 20) + "..." : Model.FeaturedGame.Title)
                                </h6>
                                <p class="text-muted mb-2" style="font-size: 0.85rem;">
                                    <i class="bi bi-calendar-event"></i> @Model.FeaturedGame.ReleaseYear
                                </p>
                                <p class="text-muted small mb-0" style="font-size: 0.75rem;">
                                    <i class="bi bi-building"></i> @Model.FeaturedGame.DeveloperPublisher
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</article>
