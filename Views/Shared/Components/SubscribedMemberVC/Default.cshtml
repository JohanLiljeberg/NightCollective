@model Night.ViewModels.CollectiveMemberViewModel

<article class="subscribed-member-card card h-100 border-0 overflow-hidden">
    @if (!string.IsNullOrEmpty(Model.ImageSmallUrl))
    {
        <img src="@Model.ImageSmallUrl" 
             alt="@Model.Name" 
             class="card-img-top"
             style="height: 200px; object-fit: cover;"
             loading="lazy" />
    }
    else
    {
        <div class="card-img-top bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center" 
             style="height: 200px;">
            <span class="display-1 text-muted opacity-25">👤</span>
        </div>
    }

    <div class="card-body d-flex flex-column p-4">
        <div class="d-flex align-items-start gap-2 mb-3">
            <div class="badge bg-primary bg-opacity-10 text-primary border border-primary">Subscribed</div>
        </div>

        <h2 class="h5 card-title mb-2">@Model.Name</h2>

        @if (!string.IsNullOrEmpty(Model.Position))
        {
            <p class="text-accent fw-semibold mb-3">@Model.Position</p>
        }

        @if (Model.FeaturedGame is not null)
        {
            <div class="mt-auto pt-3 border-top">
                <h3 class="h6 text-uppercase text-muted mb-2">Featured Work</h3>
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.FeaturedGame.ImageSmallUrl))
                    {
                        <img src="@Model.FeaturedGame.ImageSmallUrl" 
                             alt="@Model.FeaturedGame.Title" 
                             class="rounded border"
                             width="64" 
                             height="64"
                             style="object-fit: cover;"
                             loading="lazy" />
                    }
                    <div class="flex-grow-1">
                        <p class="fw-semibold mb-0">@Model.FeaturedGame.Title</p>
                        <p class="small text-muted mb-0">@Model.FeaturedGame.ReleaseYear</p>
                    </div>
                </div>
            </div>
        }
    </div>
</article>
