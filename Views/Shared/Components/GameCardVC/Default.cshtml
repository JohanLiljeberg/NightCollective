@model Night.ViewModels.GameViewModel

<div class="card h-100 shadow-sm game-card">
    @if (!string.IsNullOrEmpty(Model.ImageMediumUrl))
    {
        <img src="@Model.ImageMediumUrl" 
             class="card-img-top" 
             alt="@Model.Title"
             style="height: 200px; object-fit: cover;" />
    }
    else
    {
        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
            <i class="bi bi-controller fs-1 text-muted"></i>
        </div>
    }

    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text text-muted mb-2">
            <small>
                <i class="bi bi-calendar3"></i> @Model.ReleaseYear<br />
                <i class="bi bi-building"></i> @Model.DeveloperPublisher<br />
                <i class="bi bi-@(Model.Platforms == Night.Models.Platforms.PC ? "pc-display" : 
                                   Model.Platforms == Night.Models.Platforms.Console ? "controller" : 
                                   "phone")"></i> @Model.Platforms
            </small>
        </p>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="card-text flex-grow-1">
                @(Model.Description.Length > 100 ? Model.Description.Substring(0, 100) + "..." : Model.Description)
            </p>
        }

        <div class="mt-auto">
            @if (Model.FromCollective)
            {
                <span class="badge bg-success mb-2">
                    <i class="bi bi-star-fill"></i> Collective Game
                </span>
            }

            @if (Model.MemberContributions.Any())
            {
                <div class="text-muted">
                    <small>
                        <i class="bi bi-people"></i> @Model.MemberContributions.Count contributor(s)
                    </small>
                </div>
            }
        </div>
    </div>
</div>
