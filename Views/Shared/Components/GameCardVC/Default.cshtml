@model Night.ViewModels.GameViewModel

<div class="card h-100 shadow-sm game-card @(Model.FromCollective ? "game-card-collective" : "game-card-external")">
    <div class="position-relative">
        @if (!string.IsNullOrEmpty(Model.ImageSmallUrl) || !string.IsNullOrEmpty(Model.ImageMediumUrl))
        {
            @* Small size is enough for this thumbnail - keeps mobile data usage down *@
            <img src="@(Model.ImageSmallUrl ?? Model.ImageMediumUrl)" 
                 class="card-img-top" 
                 alt="@Model.Title"
                 loading="lazy"
                 decoding="async"
                 style="height: 200px; object-fit: cover;" />
        }
        else
        {
            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                <i class="bi bi-controller fs-1 text-muted"></i>
            </div>
        }

        @if (!Model.IsReleased)
        {
            <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                <i class="bi bi-hourglass-split"></i> Coming Soon
            </span>
        }
    </div>

    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text text-muted mb-2">
            <small>
                @if (Model.IsReleased)
                {
                    <span><i class="bi bi-calendar3"></i> @Model.ReleaseYear</span>
                }
                else if (Model.ReleaseDate.HasValue)
                {
                    <span class="text-warning-emphasis"><i class="bi bi-calendar-event"></i> Releasing @Model.ReleaseDate.Value.ToString("MMM d, yyyy")</span>
                }
                else
                {
                    <span class="text-warning-emphasis"><i class="bi bi-calendar-event"></i> Release date TBA</span>
                }
                <br />
                <i class="bi bi-building"></i> @Model.DeveloperPublisher<br />
                <i class="bi bi-@(Model.Platforms == Night.Models.Platforms.PC ? "pc-display" : 
                                   Model.Platforms == Night.Models.Platforms.Console ? "controller" : 
                                   "phone")"></i> @Model.Platforms
            </small>
        </p>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="card-text flex-grow-1">
                @(Model.Description.Length > 100 ? Model.Description.Substring(0, 100) + "..." : Model.Description)
            </p>
        }

        <div class="mt-auto">
            @if (Model.FromCollective)
            {
                <span class="badge badge-gold mb-2">Collective Game</span>
            }

            @if (Model.MemberContributions.Any())
            {
                <div class="mt-2">
                    <small class="text-muted d-block mb-1"><i class="bi bi-people"></i> Contributors</small>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var contribution in Model.MemberContributions)
                            {
                                var badgeColor = contribution.InvolvementLevel switch
                                {
                                    Night.Models.InvolvementLevel.Lead => "danger",
                                    Night.Models.InvolvementLevel.Major => "warning",
                                    _ => "secondary"
                                };
                            <div class="d-flex align-items-center gap-1" 
                                 data-bs-toggle="tooltip" 
                                 title="@contribution.Name — @contribution.InvolvementLevel">
                                @* Fixed 32px avatar size: no direct Bootstrap utility for custom pixel dimensions *@
                                @if (!string.IsNullOrEmpty(contribution.ImageSmallUrl))
                                {
                                    <img src="@contribution.ImageSmallUrl"
                                         alt="@contribution.Name"
                                         class="rounded-circle border border-2"
                                         loading="lazy"
                                         style="width:32px;height:32px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center border border-2"
                                         style="width:32px;height:32px;flex-shrink:0;">
                                        <i class="bi bi-person-fill text-white" style="font-size:0.8rem;"></i>
                                    </div>
                                }
                                <span class="badge bg-@badgeColor" style="font-size:0.65rem;">@contribution.InvolvementLevel</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
