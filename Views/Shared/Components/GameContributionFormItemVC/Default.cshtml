@model Night.ViewModels.GameContributionFormItemViewModel
@using Night.Models
@using Night.Extensions

<div class="game-contribution-item card mb-3" data-index="@Model.Index">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h6 class="mb-0">Game Contribution #@(Model.Index + 1)</h6>
            <button type="button" class="btn btn-sm btn-danger remove-game-contribution-btn" data-index="@Model.Index">
                <span aria-hidden="true">&times;</span> Remove
            </button>
        </div>

        <div class="mb-3">
            <label class="form-label" for="game-select-@Model.MemberFormId-@Model.Index">Game</label>
            <div class="d-flex align-items-center gap-2">
                <img class="game-select-preview rounded-circle border" width="32" height="32" style="object-fit: cover;" src="" alt="" />
                <select class="form-select game-select" 
                        id="game-select-@Model.MemberFormId-@Model.Index"
                        name="MemberForm.GameContributions[@Model.Index].GameId" 
                        required>
                    <option value="">Select a game...</option>
                    @foreach (var group in Model.AvailableGames.GroupBy(g => g.FromCollective).OrderByDescending(g => g.Key))
                    {
                        <optgroup label="@(group.Key ? "Collective Games" : "Other Games")">
                            @foreach (var game in group)
                            {
                                var isSelected = game.Id.ToString() == Model.Contribution.GameId.ToString();
                                <option value="@game.Id" data-img="@game.ImageUrl" selected="@isSelected">@game.Title</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Involvement Level</label>
            <div class="btn-group w-100" role="group" aria-label="Involvement level selection">
                @foreach (InvolvementLevel level in Enum.GetValues(typeof(InvolvementLevel)))
                {
                    var icon = level switch
                    {
                        InvolvementLevel.Lead => "🥇",
                        InvolvementLevel.Major => "🥈",
                        InvolvementLevel.Supporting => "🥉",
                        _ => ""
                    };
                    var isChecked = Model.Contribution.InvolvementLevel == level;
                    var inputId = $"game-involvement-{Model.MemberFormId}-{Model.Index}-{level}";

                    <input type="radio" 
                           class="btn-check" 
                           name="MemberForm.GameContributions[@Model.Index].InvolvementLevel" 
                           id="@inputId" 
                           value="@((int)level)" 
                           @(isChecked ? "checked" : "") 
                           autocomplete="off" />
                    <label class="btn btn-outline-primary" for="@inputId">
                        @icon @level
                    </label>
                }
            </div>
        </div>

        <div class="mb-0">
            <label class="form-label">Work Areas <small class="text-muted">(select all that apply)</small></label>
            <div class="row g-2">
                @foreach (var workArea in WorkAreaExtensions.GetAllWorkAreas())
                {
                    var isChecked = Model.Contribution.SelectedWorkAreas.Contains(workArea);
                    var checkboxId = $"game-work-area-{Model.MemberFormId}-{Model.Index}-{workArea}";

                    <div class="col-sm-6">
                        <div class="form-check">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   name="MemberForm.GameContributions[@Model.Index].SelectedWorkAreas" 
                                   id="@checkboxId" 
                                   value="@((int)workArea)" 
                                   @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="@checkboxId">
                                @workArea.GetIconWithName()
                            </label>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
