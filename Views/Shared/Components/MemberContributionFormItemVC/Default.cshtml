@model Night.ViewModels.MemberContributionFormItemViewModel
@using Night.Models
@using Night.Extensions

<div class="member-contribution-item card mb-3" data-index="@Model.Index">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h6 class="mb-0">Member Contribution #@(Model.Index + 1)</h6>
            <button type="button" class="btn btn-sm btn-danger remove-contribution-btn" data-index="@Model.Index">
                <span aria-hidden="true">&times;</span> Remove
            </button>
        </div>

        <div class="mb-3">
            <label class="form-label" for="member-select-@Model.GameFormId-@Model.Index">Member</label>
            <select class="form-select" 
                    id="member-select-@Model.GameFormId-@Model.Index"
                    name="GameForm.MemberContributions[@Model.Index].MemberId" 
                    required>
                <option value="">Select a member...</option>
                @foreach (var member in Model.AvailableMembers)
                {
                    var isSelected = member.Value == Model.Contribution.MemberId.ToString();
                    <option value="@member.Value" selected="@isSelected">@member.Text</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Involvement Level</label>
            <div class="btn-group w-100" role="group" aria-label="Involvement level selection">
                @foreach (InvolvementLevel level in Enum.GetValues(typeof(InvolvementLevel)))
                {
                    var icon = level switch
                    {
                        InvolvementLevel.Lead => "🥇",
                        InvolvementLevel.Major => "🥈",
                        InvolvementLevel.Supporting => "🥉",
                        _ => ""
                    };
                    var isChecked = Model.Contribution.InvolvementLevel == level;
                    var inputId = $"involvement-{Model.GameFormId}-{Model.Index}-{level}";

                    <input type="radio" 
                           class="btn-check" 
                           name="GameForm.MemberContributions[@Model.Index].InvolvementLevel" 
                           id="@inputId" 
                           value="@((int)level)" 
                           @(isChecked ? "checked" : "") 
                           autocomplete="off" />
                    <label class="btn btn-outline-primary" for="@inputId">
                        @icon @level
                    </label>
                }
            </div>
        </div>

        <div class="mb-0">
            <label class="form-label">Work Areas <small class="text-muted">(select all that apply)</small></label>
            <div class="row g-2">
                @foreach (var workArea in WorkAreaExtensions.GetAllWorkAreas())
                {
                    var isChecked = Model.Contribution.SelectedWorkAreas.Contains(workArea);
                    var checkboxId = $"work-area-{Model.GameFormId}-{Model.Index}-{workArea}";

                    <div class="col-sm-6">
                        <div class="form-check">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   name="GameForm.MemberContributions[@Model.Index].SelectedWorkAreas" 
                                   id="@checkboxId" 
                                   value="@((int)workArea)" 
                                   @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="@checkboxId">
                                @workArea.GetIconWithName()
                            </label>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
