@model Night.ViewModels.CollectiveMemberViewModel
@using Night.Models
@using Night.Extensions

<article class="collective-member-card card h-100 border-0 shadow-sm">
    <div class="card-body d-flex flex-column p-4">
        @* Member Header with Circular Profile Picture *@
        <div class="text-center mb-3">
            <div class="position-relative d-inline-block mb-3">
                <img src="@(Model.ImageSmallUrl ?? Model.Image)" 
                     alt="@Model.Name" 
                     class="rounded-circle border border-3 border-primary shadow-sm"
                     width="100" 
                     height="100"
                     style="object-fit: cover;" />
                <span class="position-absolute bottom-0 end-0 badge bg-primary rounded-circle p-2" title="Collective Member">
                    <i class="bi bi-person-badge"></i>
                </span>
            </div>
            <h2 class="h5 card-title mb-1 fw-bold">@Model.Name</h2>
            <p class="text-muted small mb-2">
                <i class="bi bi-briefcase"></i>
                @Model.Position
            </p>
            <p class="fst-italic text-muted small mb-0 px-3" style="line-height: 1.4;">
                "@Model.Quote"
            </p>
        </div>

        @* Game Portfolio Section *@
        <div class="mt-auto">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                    <i class="bi bi-controller"></i>
                    @Model.GameContributions.Count @(Model.GameContributions.Count == 1 ? "Game" : "Games")
                </span>
            </div>

            @if (Model.GameContributions.Any())
            {
                @if (Model.GameContributions.Count <= 3)
                {
                    @* Simple Grid for 1-3 games *@
                    <div class="row g-2">
                        @foreach (var contribution in Model.GameContributions)
                        {
                            <div class="col-12">
                                <div class="card border h-100 game-mini-card">
                                    <div class="row g-0 align-items-center">
                                        <div class="col-4">
                                            <img src="@(contribution.ImageSmallUrl ?? contribution.Image)" 
                                                 alt="@contribution.Title" 
                                                 class="img-fluid rounded-start"
                                                 style="height: 80px; width: 100%; object-fit: cover;" />
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body p-2">
                                                <h6 class="card-title mb-1 small fw-bold text-truncate" title="@contribution.Title">
                                                    @contribution.Title
                                                </h6>
                                                <p class="text-muted mb-1" style="font-size: 0.7rem;">
                                                    <i class="bi bi-calendar-event"></i> @contribution.ReleaseYear
                                                </p>
                                                <span class="badge @(contribution.InvolvementLevel switch
                                                {
                                                    InvolvementLevel.Lead => "bg-warning text-dark",
                                                    InvolvementLevel.Major => "bg-info text-dark",
                                                    InvolvementLevel.Supporting => "bg-success",
                                                    _ => "bg-secondary"
                                                }) px-2 py-1" style="font-size: 0.65rem;">
                                                    @(contribution.InvolvementLevel switch
                                                    {
                                                        InvolvementLevel.Lead => "🥇 Lead",
                                                        InvolvementLevel.Major => "🥈 Major",
                                                        InvolvementLevel.Supporting => "🥉 Supporting",
                                                        _ => ""
                                                    })
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* Carousel for 4+ games *@
                    <div id="gameCarousel-@Model.Id" class="carousel slide" data-bs-ride="false">
                        <div class="carousel-indicators">
                            @for (int i = 0; i < Math.Ceiling(Model.GameContributions.Count / 3.0); i++)
                            {
                                <button type="button" 
                                        data-bs-target="#gameCarousel-@Model.Id" 
                                        data-bs-slide-to="@i" 
                                        class="@(i == 0 ? "active" : "")"
                                        aria-current="@(i == 0 ? "true" : "false")" 
                                        aria-label="Slide @(i + 1)"></button>
                            }
                        </div>
                        <div class="carousel-inner">
                            @{
                                var chunkedGames = Model.GameContributions
                                    .Select((game, index) => new { game, index })
                                    .GroupBy(x => x.index / 3)
                                    .Select(g => g.Select(x => x.game).ToList())
                                    .ToList();
                            }
                            @for (int chunkIndex = 0; chunkIndex < chunkedGames.Count; chunkIndex++)
                            {
                                var chunk = chunkedGames[chunkIndex];
                                <div class="carousel-item @(chunkIndex == 0 ? "active" : "")">
                                    <div class="row g-2 px-2">
                                        @foreach (var contribution in chunk)
                                        {
                                            <div class="col-12">
                                                <div class="card border h-100 game-mini-card">
                                                    <div class="row g-0 align-items-center">
                                                        <div class="col-4">
                                                            <img src="@(contribution.ImageSmallUrl ?? contribution.Image)" 
                                                                 alt="@contribution.Title" 
                                                                 class="img-fluid rounded-start"
                                                                 style="height: 80px; width: 100%; object-fit: cover;" />
                                                        </div>
                                                        <div class="col-8">
                                                            <div class="card-body p-2">
                                                                <h6 class="card-title mb-1 small fw-bold text-truncate" title="@contribution.Title">
                                                                    @contribution.Title
                                                                </h6>
                                                                <p class="text-muted mb-1" style="font-size: 0.7rem;">
                                                                    <i class="bi bi-calendar-event"></i> @contribution.ReleaseYear
                                                                </p>
                                                                <span class="badge @(contribution.InvolvementLevel switch
                                                                {
                                                                    InvolvementLevel.Lead => "bg-warning text-dark",
                                                                    InvolvementLevel.Major => "bg-info text-dark",
                                                                    InvolvementLevel.Supporting => "bg-success",
                                                                    _ => "bg-secondary"
                                                                }) px-2 py-1" style="font-size: 0.65rem;">
                                                                    @(contribution.InvolvementLevel switch
                                                                    {
                                                                        InvolvementLevel.Lead => "🥇 Lead",
                                                                        InvolvementLevel.Major => "🥈 Major",
                                                                        InvolvementLevel.Supporting => "🥉 Supporting",
                                                                        _ => ""
                                                                    })
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#gameCarousel-@Model.Id" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#gameCarousel-@Model.Id" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-3">
                    <i class="bi bi-inbox display-6 text-muted opacity-25"></i>
                    <p class="text-muted small mb-0 mt-2">No games listed yet.</p>
                </div>
            }
        </div>
    </div>
</article>

<style>
    .game-mini-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .game-mini-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        filter: invert(0);
    }

    .carousel-indicators [data-bs-target] {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
</style>
