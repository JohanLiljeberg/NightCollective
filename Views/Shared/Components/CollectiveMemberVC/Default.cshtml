@model Night.ViewModels.CollectiveMemberViewModel
@using Night.Models
@using Night.Extensions

<article class="collective-member-card card h-100 border-0 shadow-sm overflow-hidden">
    @* Hero Image *@
    @await Component.InvokeAsync("ResponsiveImageVC", new
    {
        smallUrl = Model.ImageSmallUrl,
        mediumUrl = Model.ImageMediumUrl,
        largeUrl = Model.ImageLargeUrl,
        altText = $"Portrait or artwork for {Model.Name}",
        cssClass = "collective-member-image card-img-top",
        width = 640,
        height = 480,
        aspectRatio = "4 / 3"
    })

    <div class="card-body d-flex flex-column p-4">
        @* Member Info *@
        <div class="mb-4">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">
                    <i class="bi bi-person-badge"></i> Collective Member
                </span>
            </div>
            <h2 class="h3 card-title mb-2 fw-bold">@Model.Name</h2>
            <p class="text-accent fw-semibold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-briefcase"></i>
                @Model.Position
            </p>
            <blockquote class="collective-member-quote border-start border-4 border-primary ps-3 mb-0">
                <p class="fst-italic text-muted mb-0">"@Model.Quote"</p>
            </blockquote>
        </div>

        @* Portfolio Section *@
        <div class="mt-auto">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h5 mb-0 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-controller"></i>
                    Game Portfolio
                </h3>
                <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2">
                    @Model.GameContributions.Count @(Model.GameContributions.Count == 1 ? "Game" : "Games")
                </span>
            </div>

            @if (Model.GameContributions.Any())
            {
                <div class="game-portfolio-grid">
                    @foreach (var contribution in Model.GameContributions)
                    {
                        <div class="game-portfolio-item position-relative">
                            @* Game Card *@
                            <div class="card border-0 shadow-sm h-100 overflow-hidden game-card-hover">
                                @* Game Image *@
                                <div class="position-relative">
                                    <img src="@contribution.Image" 
                                         alt="@contribution.Title" 
                                         class="card-img-top"
                                         style="height: 120px; object-fit: cover;"
                                         loading="lazy" />

                                    @* Involvement Badge *@
                                    <div class="position-absolute top-0 end-0 m-2">
                                        @{
                                            var (badgeClass, badgeIcon, badgeText) = contribution.InvolvementLevel switch
                                            {
                                                InvolvementLevel.Lead => ("bg-warning text-dark", "bi-trophy-fill", "Lead"),
                                                InvolvementLevel.Major => ("bg-info text-dark", "bi-star-fill", "Major"),
                                                InvolvementLevel.Supporting => ("bg-success text-white", "bi-hand-thumbs-up-fill", "Supporting"),
                                                _ => ("bg-secondary text-white", "bi-circle-fill", "")
                                            };
                                        }
                                        <span class="badge @badgeClass shadow-sm px-2 py-1">
                                            <i class="bi @badgeIcon"></i>
                                            @badgeText
                                        </span>
                                    </div>
                                </div>

                                @* Game Info *@
                                <div class="card-body p-3">
                                    <h4 class="h6 card-title mb-1 fw-bold text-truncate" title="@contribution.Title">
                                        @contribution.Title
                                    </h4>
                                    <p class="small text-muted mb-2">
                                        <i class="bi bi-calendar-event"></i>
                                        @contribution.ReleaseYear
                                    </p>

                                    @* Work Areas *@
                                    @if (contribution.WorkAreas.Any())
                                    {
                                        <div class="work-areas-pills d-flex flex-wrap gap-1">
                                            @foreach (var workArea in contribution.WorkAreas.Take(3))
                                            {
                                                <span class="badge bg-light text-dark border px-2 py-1 small" title="@workArea.GetName()">
                                                    @workArea.GetIcon()
                                                    @workArea.GetName()
                                                </span>
                                            }
                                            @if (contribution.WorkAreas.Count > 3)
                                            {
                                                <span class="badge bg-light text-muted border px-2 py-1 small">
                                                    +@(contribution.WorkAreas.Count - 3) more
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox display-4 text-muted opacity-25"></i>
                    <p class="text-muted mb-0 mt-2">No games listed yet.</p>
                </div>
            }
        </div>
    </div>
</article>
