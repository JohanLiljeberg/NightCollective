@model Night.Models.BlogPost

<a asp-controller="Blog" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">
    <article class="content-card h-100 overflow-hidden rounded-4 blog-post-card">
        @if (!string.IsNullOrEmpty(Model.ImageMediumUrl))
        {
            @await Component.InvokeAsync("ResponsiveImageVC", new
            {
                smallUrl = Model.ImageSmallUrl,
                mediumUrl = Model.ImageMediumUrl,
                largeUrl = Model.ImageLargeUrl,
                altText = Model.Title,
                cssClass = "blog-card-image w-100",
                width = 800,
                height = 600,
                aspectRatio = "4 / 3"
            })
        }
        else
        {
            <div class="bg-light d-flex align-items-center justify-content-center" style="aspect-ratio: 4 / 3;">
                <i class="bi bi-file-text display-1 text-muted"></i>
            </div>
        }
        <div class="p-4">
            <h3 class="h4 mb-2">@Model.Title</h3>
            <p class="text-muted small mb-3">
                <i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("MMMM dd, yyyy")
            </p>
            <p class="mb-3">@(Model.Content.Length > 150 ? Model.Content.Substring(0, 150) + "..." : Model.Content)</p>
            @if (!string.IsNullOrEmpty(Model.ExternalLink))
            {
                <p class="small text-accent mb-0">
                    <i class="bi bi-link-45deg"></i> Featured Link
                </p>
            }
        </div>
    </article>
</a>
