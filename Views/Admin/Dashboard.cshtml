@model Night.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var activeTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab)) activeTab = "events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🛠️ Admin Dashboard</h1>
    <a asp-action="Logout" class="btn btn-outline-danger">Logout</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<ul class="nav nav-tabs mb-4" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "events" ? "active" : "")" id="events-tab" data-bs-toggle="tab" data-bs-target="#events" type="button" role="tab">
            📅 Create Event
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "games" ? "active" : "")" id="games-tab" data-bs-toggle="tab" data-bs-target="#games" type="button" role="tab">
            🎮 Add Game
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "members" ? "active" : "")" id="members-tab" data-bs-toggle="tab" data-bs-target="#members" type="button" role="tab">
            👥 Add Member
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "manage-members" ? "active" : "")" id="manage-members-tab" data-bs-toggle="tab" data-bs-target="#manage-members" type="button" role="tab">
            📋 Manage Members
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "manage-games" ? "active" : "")" id="manage-games-tab" data-bs-toggle="tab" data-bs-target="#manage-games" type="button" role="tab">
            🎯 Manage Games
        </button>
    </li>
</ul>

<div class="tab-content" id="adminTabsContent">
    <!-- Events Tab -->
    <div class="tab-pane fade @(activeTab == "events" ? "show active" : "")" id="events" role="tabpanel">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">Create New Event</h3>
            </div>
            <div class="card-body">
                <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input asp-for="EventForm.Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="EventForm.Title" class="form-label"></label>
                        <input asp-for="EventForm.Title" class="form-control" required />
                        <span asp-validation-for="EventForm.Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EventForm.Date" class="form-label"></label>
                        <input asp-for="EventForm.Date" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="EventForm.Date" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EventForm.Location" class="form-label"></label>
                        <input asp-for="EventForm.Location" class="form-control" required />
                        <span asp-validation-for="EventForm.Location" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EventForm.Description" class="form-label"></label>
                        <textarea asp-for="EventForm.Description" class="form-control" rows="5" required></textarea>
                        <span asp-validation-for="EventForm.Description" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <fieldset class="border border-2 rounded p-3">
                            <legend class="form-label d-block mb-3">Event Image</legend>
                            <p class="small text-muted mb-4">Choose one: Upload a file <strong>OR</strong> provide an image URL</p>

                            <div class="mb-3">
                                <h6 class="mb-2">📁 Upload Image</h6>
                                <input asp-for="EventForm.ImageFile" type="file" class="form-control" accept="image/*" />
                            </div>

                            <div class="text-center text-muted my-3">
                                <small><strong>— OR —</strong></small>
                            </div>

                            <div class="mb-3">
                                <h6 class="mb-2">🔗 Add Image URL</h6>
                                <input asp-for="EventForm.ImageUrl" class="form-control" placeholder="https://example.com/image.svg" />
                            </div>
                        </fieldset>
                    </div>

                    <button type="submit" class="btn btn-primary">Create Event</button>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary">View All Events</a>
                </form>
            </div>
        </div>
    </div>

    <!-- Games Tab -->
    <div class="tab-pane fade @(activeTab == "games" ? "show active" : "")" id="games" role="tabpanel">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">Add New Game</h3>
            </div>
            <div class="card-body">
                <form asp-action="CreateGame" method="post">
                    @Html.Partial("~/Views/Home/_GameFields.cshtml", Model.GameForm)
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Add Game</button>
                        <a asp-controller="Home" asp-action="Members" class="btn btn-outline-secondary">View All Games</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Members Tab -->
    <div class="tab-pane fade @(activeTab == "members" ? "show active" : "")" id="members" role="tabpanel">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">Add New Member</h3>
            </div>
            <div class="card-body">
                <form asp-action="CreateMember" method="post">
                    @Html.Partial("~/Views/Home/_MemberFields.cshtml", Model.MemberForm)
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Add Member</button>
                        <a asp-controller="Home" asp-action="Members" class="btn btn-outline-secondary">View All Members</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Manage Members Tab -->
    <div class="tab-pane fade @(activeTab == "manage-members" ? "show active" : "")" id="manage-members" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="mb-0">Manage All Members</h3>
                <span class="badge bg-primary">@Model.AllMembers.Count Total</span>
            </div>
            <div class="card-body">
                @* Filter Buttons *@
                <div class="btn-group mb-4" role="group" aria-label="Filter members">
                    <input type="radio" class="btn-check" name="memberFilter" id="filterAll" value="all" autocomplete="off" checked />
                    <label class="btn btn-outline-primary" for="filterAll">
                        All (@Model.AllMembers.Count)
                    </label>

                    <input type="radio" class="btn-check" name="memberFilter" id="filterFull" value="@((int)Night.Models.MembershipType.Full)" autocomplete="off" />
                    <label class="btn btn-outline-success" for="filterFull">
                        <i class="bi bi-star-fill"></i> Full Members (@Model.AllMembers.Count(m => m.MembershipType == Night.Models.MembershipType.Full))
                    </label>

                    <input type="radio" class="btn-check" name="memberFilter" id="filterSubscribed" value="@((int)Night.Models.MembershipType.Subscribed)" autocomplete="off" />
                    <label class="btn btn-outline-info" for="filterSubscribed">
                        <i class="bi bi-person-check"></i> Subscribed (@Model.AllMembers.Count(m => m.MembershipType == Night.Models.MembershipType.Subscribed))
                    </label>

                    <input type="radio" class="btn-check" name="memberFilter" id="filterUnsubscribed" value="@((int)Night.Models.MembershipType.Unsubscribed)" autocomplete="off" />
                    <label class="btn btn-outline-secondary" for="filterUnsubscribed">
                        <i class="bi bi-person-dash"></i> Unsubscribed (@Model.AllMembers.Count(m => m.MembershipType == Night.Models.MembershipType.Unsubscribed))
                    </label>
                </div>

                @* Members List *@
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Image</th>
                                <th>Name</th>
                                <th>Position</th>
                                <th style="width: 150px;">Type</th>
                                <th style="width: 100px;">Games</th>
                                <th style="width: 180px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="membersTableBody">
                            @foreach (var member in Model.AllMembers.OrderBy(m => m.Name))
                            {
                                var membershipClass = member.MembershipType switch
                                {
                                    Night.Models.MembershipType.Full => "bg-success-subtle text-success",
                                    Night.Models.MembershipType.Subscribed => "bg-info-subtle text-info",
                                    Night.Models.MembershipType.Unsubscribed => "bg-secondary-subtle text-secondary",
                                    _ => ""
                                };

                                var membershipIcon = member.MembershipType switch
                                {
                                    Night.Models.MembershipType.Full => "bi-star-fill",
                                    Night.Models.MembershipType.Subscribed => "bi-person-check",
                                    Night.Models.MembershipType.Unsubscribed => "bi-person-dash",
                                    _ => ""
                                };

                                <tr class="member-row" data-membership-type="@((int)member.MembershipType)">
                                    <td>
                                        @if (!string.IsNullOrEmpty(member.ImageSmallUrl))
                                        {
                                            <img src="@member.ImageSmallUrl" 
                                                 alt="@member.Name" 
                                                 class="rounded" 
                                                 width="60" 
                                                 height="60" 
                                                 style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="bi bi-person-circle fs-3 text-muted"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@member.Name</strong>
                                    </td>
                                    <td class="text-muted">
                                        <small>@member.Position</small>
                                    </td>
                                    <td>
                                        <span class="badge @membershipClass px-3 py-2">
                                            <i class="bi @membershipIcon"></i>
                                            @member.MembershipType
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">
                                            @member.GameContributions.Count
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-primary me-1" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#editMemberModal-@member.Id">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deleteMemberModal-@member.Id">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Manage Games Tab -->
    <div class="tab-pane fade @(activeTab == "manage-games" ? "show active" : "")" id="manage-games" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="bi bi-controller"></i> Manage Games
                </h3>
            </div>
            <div class="card-body">
                @if (!Model.AllGames.Any())
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> No games added yet. Use the "Add Game" tab to create your first game.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 100px;">Cover</th>
                                    <th>Title</th>
                                    <th>Year</th>
                                    <th>Developer</th>
                                    <th>Platform</th>
                                    <th class="text-center">Contributors</th>
                                    <th class="text-center">Collective</th>
                                    <th class="text-end" style="width: 180px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var game in Model.AllGames.OrderBy(g => g.Title))
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(game.ImageSmallUrl))
                                            {
                                                <img src="@game.ImageSmallUrl" 
                                                     alt="@game.Title" 
                                                     class="rounded" 
                                                     width="80" 
                                                     height="80" 
                                                     style="object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                                    <i class="bi bi-controller fs-3 text-muted"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <strong>@game.Title</strong>
                                            <br />
                                            <small class="text-muted">@game.GenreGameplayType</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@game.ReleaseYear</span>
                                        </td>
                                        <td>
                                            <small>@game.DeveloperPublisher</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark">
                                                <i class="bi bi-@(game.Platforms == Night.Models.Platforms.PC ? "pc-display" : 
                                                                   game.Platforms == Night.Models.Platforms.Console ? "controller" : 
                                                                   "phone")"></i>
                                                @game.Platforms
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">
                                                @game.MemberContributions.Count
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (game.FromCollective)
                                            {
                                                <i class="bi bi-check-circle-fill text-success" title="From Collective"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-dash-circle text-muted" title="Not from Collective"></i>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-primary me-1" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#editGameModal-@game.Id">
                                                <i class="bi bi-pencil"></i> Edit
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#deleteGameModal-@game.Id">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Edit Member Modals *@
@foreach (var member in Model.AllMembers)
{
    <div class="modal fade" id="editMemberModal-@member.Id" tabindex="-1" aria-labelledby="editMemberModalLabel-@member.Id" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editMemberModalLabel-@member.Id">
                        <i class="bi bi-pencil"></i> Edit @member.Name
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="UpdateMember" method="post">
                    <div class="modal-body">
                        @{
                            var editForm = new Night.ViewModels.CollectiveMemberFormViewModel
                            {
                                Id = member.Id,
                                Name = member.Name,
                                Image = member.Image,
                                Position = member.Position,
                                Quote = member.Quote,
                                MembershipType = member.MembershipType,
                                FeaturedGameId = member.FeaturedGame?.Id,
                                SelectedGameIds = member.Games.Select(g => g.Id).ToList(),
                                AvailableGames = Model.AllGames
                                    .Select(g => new Night.ViewModels.GameSelectViewModel { Id = g.Id, Title = g.Title })
                                    .ToList()
                            };
                        }
                        @Html.Partial("~/Views/Home/_MemberFields.cshtml", editForm)
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* Delete Member Modals *@
@foreach (var member in Model.AllMembers)
{
    <div class="modal fade" id="deleteMemberModal-@member.Id" tabindex="-1" aria-labelledby="deleteMemberModalLabel-@member.Id" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteMemberModalLabel-@member.Id">
                        <i class="bi bi-exclamation-triangle"></i> Confirm Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="DeleteMember" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@member.Id" />
                    <div class="modal-body">
                        <p class="mb-3">Are you sure you want to <strong>permanently delete</strong> this member?</p>
                        <div class="card bg-light">
                            <div class="card-body">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(member.ImageSmallUrl))
                                    {
                                        <img src="@member.ImageSmallUrl" alt="@member.Name" class="rounded" width="60" height="60" style="object-fit: cover;" />
                                    }
                                    <div>
                                        <h6 class="mb-1">@member.Name</h6>
                                        <p class="small text-muted mb-0">@member.Position</p>
                                        <span class="badge bg-secondary mt-1">@member.MembershipType</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Warning:</strong> This action cannot be undone. All associated data will be removed.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete Permanently
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* Edit Game Modals *@
@foreach (var game in Model.AllGames)
{
    <div class="modal fade" id="editGameModal-@game.Id" tabindex="-1" aria-labelledby="editGameModalLabel-@game.Id" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editGameModalLabel-@game.Id">
                        <i class="bi bi-pencil"></i> Edit @game.Title
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="UpdateGame" method="post">
                    <div class="modal-body">
                        @{
                            var editGameForm = new Night.ViewModels.GameFormViewModel
                            {
                                Id = game.Id,
                                Title = game.Title,
                                Image = game.Image,
                                ReleaseYear = game.ReleaseYear,
                                DeveloperPublisher = game.DeveloperPublisher,
                                Platforms = game.Platforms,
                                GenreGameplayType = game.GenreGameplayType,
                                FromCollective = game.FromCollective,
                                AvailableMembers = Model.GameForm.AvailableMembers,
                                MemberContributions = game.MemberContributions
                                    .Select((mc, index) => new Night.ViewModels.GameMemberContributionFormViewModel
                                    {
                                        MemberId = mc.MemberId,
                                        InvolvementLevel = mc.InvolvementLevel,
                                        SelectedWorkAreas = mc.WorkAreas.ToList()
                                    })
                                    .ToList()
                            };
                        }
                        @Html.Partial("~/Views/Home/_GameFields.cshtml", editGameForm)
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* Delete Game Modals *@
@foreach (var game in Model.AllGames)
{
    <div class="modal fade" id="deleteGameModal-@game.Id" tabindex="-1" aria-labelledby="deleteGameModalLabel-@game.Id" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteGameModalLabel-@game.Id">
                        <i class="bi bi-exclamation-triangle"></i> Delete Game
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="DeleteGame" method="post">
                    <input type="hidden" name="id" value="@game.Id" />
                    <div class="modal-body">
                        <p class="mb-3">Are you sure you want to delete this game?</p>
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(game.ImageSmallUrl))
                                    {
                                        <img src="@game.ImageSmallUrl" 
                                             alt="@game.Title" 
                                             class="rounded me-3" 
                                             width="80" 
                                             height="80" 
                                             style="object-fit: cover;" />
                                    }
                                    <div>
                                        <h6 class="mb-1">@game.Title</h6>
                                        <p class="small text-muted mb-0">@game.DeveloperPublisher (@game.ReleaseYear)</p>
                                        <span class="badge bg-info text-dark mt-1">@game.Platforms</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Warning:</strong> This action cannot be undone. All associated data will be removed.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete Permanently
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/game-form.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Member filtering functionality
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('input[name="memberFilter"]');
            const memberRows = document.querySelectorAll('.member-row');

            filterButtons.forEach(button => {
                button.addEventListener('change', function() {
                    const filterValue = this.value;

                    memberRows.forEach(row => {
                        const membershipType = row.getAttribute('data-membership-type');

                        if (filterValue === 'all' || membershipType === filterValue) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
}
