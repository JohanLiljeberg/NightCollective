@model Night.ViewModels.GameFormViewModel
@using Night.Models

@Html.AntiForgeryToken()
<input type="hidden" name="GameForm.Id" value="@Model.Id" />

<div class="row g-3">
    <div class="col-12">
        <label class="form-label" for="game-title-@Model.Id">Title</label>
        <input class="form-control" 
               id="game-title-@Model.Id" 
               name="GameForm.Title" 
               value="@Model.Title" 
               maxlength="120" 
               required />
    </div>

    <div class="col-12">
        <label class="form-label" for="game-image-@Model.Id">Image URL</label>
        <input class="form-control" 
               id="game-image-@Model.Id" 
               name="GameForm.Image" 
               value="@Model.Image" 
               maxlength="240" 
               required />
    </div>

    <div class="col-md-6">
        <label class="form-label" for="game-year-@Model.Id">Release year</label>
        <input class="form-control" 
               id="game-year-@Model.Id" 
               name="GameForm.ReleaseYear" 
               value="@Model.ReleaseYear" 
               type="number" 
               min="1970" 
               max="2100" 
               required />
    </div>

    <div class="col-md-6">
        <label class="form-label" for="game-dev-@Model.Id">Developer / Publisher</label>
        <input class="form-control" 
               id="game-dev-@Model.Id" 
               name="GameForm.DeveloperPublisher" 
               value="@Model.DeveloperPublisher" 
               maxlength="160" 
               required />
    </div>

    <div class="col-md-6">
        <label class="form-label" for="game-platform-@Model.Id">Platform</label>
        <select class="form-select" 
                id="game-platform-@Model.Id" 
                name="GameForm.Platforms" 
                asp-items="Html.GetEnumSelectList<Platforms>()"></select>
    </div>

    <div class="col-md-6">
        <label class="form-label" for="game-genre-@Model.Id">Genre / Gameplay</label>
        <select class="form-select" 
                id="game-genre-@Model.Id" 
                name="GameForm.GenreGameplayType" 
                asp-items="Html.GetEnumSelectList<genreGameplayType>()"></select>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input class="form-check-input" 
                   id="game-collective-@Model.Id" 
                   name="GameForm.FromCollective" 
                   value="true" 
                   type="checkbox" 
                   @(Model.FromCollective ? "checked" : string.Empty) />
            <input name="GameForm.FromCollective" value="false" type="hidden" />
            <label class="form-check-label" for="game-collective-@Model.Id">
                Made by the collective members
            </label>
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">Collective members and their contributions</label>
        <div class="border rounded p-3 bg-light">
            <div id="member-contributions-list-@Model.Id" class="mb-3" data-game-id="@Model.Id">
                @for (int i = 0; i < Model.MemberContributions.Count; i++)
                {
                    @await Component.InvokeAsync("MemberContributionFormItemVC", new
                    {
                        contribution = Model.MemberContributions[i],
                        availableMembers = Model.AvailableMembers,
                        index = i,
                        gameFormId = Model.Id?.ToString() ?? "0"
                    })
                }
            </div>
            <button type="button" 
                    class="btn btn-outline-primary btn-sm add-contribution-btn" 
                    data-game-id="@Model.Id">
                <span aria-hidden="true">+</span> Add Member Contribution
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Set initial values for enum dropdowns
        const platformSelect = document.getElementById('game-platform-@Model.Id');
        const genreSelect = document.getElementById('game-genre-@Model.Id');

        if (platformSelect) platformSelect.value = '@((int)Model.Platforms)';
        if (genreSelect) genreSelect.value = '@((int)Model.GenreGameplayType)';

        // Initialize game form handler
        const gameFormHandler = new GameFormHandler('@Model.Id', @Model.MemberContributions.Count);
    });
</script>
