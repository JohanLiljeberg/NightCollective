<section id="projects" class="mb-5" aria-labelledby="projects-heading">
    <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
        <div>
            <p class="eyebrow mb-1">Latest stories</p>
            <h2 id="projects-heading" class="mb-0">Showcase</h2>
        </div>
        @if (Model.LatestBlogPosts.Any())
        {
            <a class="btn btn-primary" asp-controller="Blog" asp-action="Index">View all posts</a>
        }
    </div>
    @if (!Model.LatestBlogPosts.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No blog posts published yet. Check back soon for updates!
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var post in Model.LatestBlogPosts)
            {
                <div class="col-md-4">
                    @await Component.InvokeAsync("BlogPostCardVC", new { blogPost = post })
                </div>
            }
        </div>
    }
</section>

<section id="events" class="mb-5" aria-labelledby="events-heading">
    <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
        <div>
            <p class="eyebrow mb-1">Gatherings</p>
            <h2 id="events-heading" class="mb-0">Upcoming community events</h2>
        </div>
        <a class="btn btn-primary" asp-controller="Events" asp-action="Index">See all events</a>
    </div>
    <div class="row g-4">
        @foreach (var collectiveEvent in Model.UpcomingEvents.Take(2))
        {
            <div class="col-lg-6">
                @await Component.InvokeAsync("EventCardVC", new { collectiveEvent })
            </div>
        }
    </div>
</section>


