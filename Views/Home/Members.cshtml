@model Night.ViewModels.MembersPageViewModel
@using Night.Extensions
@{
    ViewData["Title"] = "Collective Members";
}

<div class="container py-5">
    <div class="mb-5 text-center">
        <p class="eyebrow mb-2">About the collective</p>
        <h1 class="display-6 fw-bold mb-3">Meet Our Members</h1>
        <p class="lead text-muted">Night Collective Group</p>
        <a asp-controller="Home" asp-action="Games" class="btn btn-outline-primary mt-2">
            <i class="bi bi-controller"></i> View Our Games Gallery
        </a>
    </div>

    @* Full Members Section *@
    @{
        var fullMembers = Model.Members.Where(m => m.MembershipType == Night.Models.MembershipType.Full).ToList();
    }
    @if (fullMembers.Any())
    {
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h4 fw-bold mb-0">
                    <i class="bi bi-person-badge"></i> Full Members
                </h2>
                <span class="badge bg-primary rounded-pill">@fullMembers.Count</span>
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var member in fullMembers)
                {
                    <div class="col">
                        @await Component.InvokeAsync("CollectiveMemberVC", new { member })
                    </div>
                }
            </div>
        </section>
    }

    @* Subscribed Members Section *@
    @{
        var subscribedMembers = Model.Members.Where(m => m.MembershipType == Night.Models.MembershipType.Subscribed).ToList();
    }
    @if (subscribedMembers.Any())
    {
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h4 fw-bold mb-0">
                    <i class="bi bi-star-fill"></i> Subscribed Members
                </h2>
                <span class="badge bg-primary rounded-pill">@subscribedMembers.Count</span>
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var member in subscribedMembers)
                {
                    <div class="col">
                        @await Component.InvokeAsync("SubscribedMemberVC", new { member })
                    </div>
                }
            </div>
        </section>
    }

    @* Active Members (Unsubscribed) Section *@
    @{
        var unsubscribedMembers = Model.Members.Where(m => m.MembershipType == Night.Models.MembershipType.Unsubscribed).ToList();
    }
    @if (unsubscribedMembers.Any())
    {
        <section>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h4 fw-bold mb-0">
                    <i class="bi bi-person-check"></i> Active Members
                </h2>
                <span class="badge bg-info rounded-pill">@unsubscribedMembers.Count</span>
            </div>
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
                @foreach (var member in unsubscribedMembers)
                {
                    <div class="col">
                        @await Component.InvokeAsync("UnsubscribedMemberVC", new { member })
                    </div>
                }
            </div>
        </section>
    }
</div>

<style>
    .eyebrow {
        text-transform: uppercase;
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: #6c757d;
    }
</style>
