@model Night.ViewModels.MembersPageViewModel
@{
    ViewData["Title"] = "Collective Members";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <p class="eyebrow mb-2">About the collective</p>
            <h1 class="display-6 fw-bold mb-0">Members & games</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#addMemberOffcanvas" aria-controls="addMemberOffcanvas">Add collective member</button>
            <button class="btn btn-outline-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#addGameOffcanvas" aria-controls="addGameOffcanvas">Add game</button>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var member in Model.Members)
        {
            <div class="col">
                <div class="h-100 position-relative">
                    <div class="position-absolute top-0 end-0 z-1 m-3">
                        <button class="btn btn-sm btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#editMemberOffcanvas-@member.Id" aria-controls="editMemberOffcanvas-@member.Id">Edit</button>
                    </div>
                    @await Component.InvokeAsync("CollectiveMemberVC", new { member })
                </div>
            </div>
        }
    </div>
</section>

<section class="mb-5" aria-labelledby="member-admin-heading">
    <div class="content-card rounded-4 p-4 p-lg-5">
        <p class="eyebrow mb-1">Create</p>
        <h2 id="member-admin-heading" class="h3 mb-4">Add members and assign existing games</h2>
        <div class="row g-4">
            <div class="col-lg-6">
                <h3 class="h5 mb-3">Add game to database</h3>
                <form asp-controller="Home" asp-action="AddGame" method="post" class="vstack gap-3">
                    <div>
                        <label asp-for="GameForm.Title" class="form-label"></label>
                        <input asp-for="GameForm.Title" class="form-control" />
                        <span asp-validation-for="GameForm.Title" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="GameForm.Image" class="form-label">Game image URL</label>
                        <input asp-for="GameForm.Image" class="form-control" placeholder="/images/games/example.jpg" />
                        <span asp-validation-for="GameForm.Image" class="text-danger"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="GameForm.ReleaseYear" class="form-label"></label>
                            <input asp-for="GameForm.ReleaseYear" class="form-control" />
                            <span asp-validation-for="GameForm.ReleaseYear" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="GameForm.DeveloperPublisher" class="form-label"></label>
                            <input asp-for="GameForm.DeveloperPublisher" class="form-control" />
                            <span asp-validation-for="GameForm.DeveloperPublisher" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="GameForm.Platforms" class="form-label"></label>
                            <select asp-for="GameForm.Platforms" asp-items="Html.GetEnumSelectList<Night.Models.Platforms>()" class="form-select"></select>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="GameForm.GenreGameplayType" class="form-label">Genre</label>
                            <select asp-for="GameForm.GenreGameplayType" asp-items="Html.GetEnumSelectList<Night.Models.genreGameplayType>()" class="form-select"></select>
                        </div>
                    </div>
                    <div class="form-check">
                        <input asp-for="GameForm.FromCollective" class="form-check-input" />
                        <label asp-for="GameForm.FromCollective" class="form-check-label">From the collective</label>
                    </div>
                    <button type="submit" class="btn btn-primary align-self-start">Add game</button>
                </form>
            </div>
            <div class="col-lg-6">
                <h3 class="h5 mb-3">Add member</h3>
                <form asp-controller="Home" asp-action="AddMember" method="post" class="vstack gap-3">
                    <div>
                        <label asp-for="MemberForm.Name" class="form-label"></label>
                        <input asp-for="MemberForm.Name" class="form-control" />
                        <span asp-validation-for="MemberForm.Name" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="MemberForm.Image" class="form-label">Member image URL</label>
                        <input asp-for="MemberForm.Image" class="form-control" placeholder="/images/collective-members/name.jpg" />
                        <span asp-validation-for="MemberForm.Image" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="MemberForm.Position" class="form-label"></label>
                        <input asp-for="MemberForm.Position" class="form-control" />
                        <span asp-validation-for="MemberForm.Position" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="MemberForm.Quote" class="form-label"></label>
                        <textarea asp-for="MemberForm.Quote" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="MemberForm.Quote" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="MemberForm.SelectedGameIds" class="form-label">Games from database</label>
                        <select asp-for="MemberForm.SelectedGameIds" class="form-select" multiple size="6">
                            @foreach (var game in Model.MemberForm.AvailableGames)
                            {
                                <option value="@game.Id">@game.Title</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary align-self-start">Add member</button>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="mb-5" aria-labelledby="games-gallery-heading">
    <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
        <div>
            <p class="eyebrow mb-1">Gallery</p>
            <h2 id="games-gallery-heading" class="h3 mb-0">Games database</h2>
        </div>
    </div>
    @if (Model.Games.Any())
    {
        <div class="row g-4">
            @foreach (var game in Model.Games)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <article class="card h-100 border-0 overflow-hidden">
                        <img class="card-img-top" src="@game.Image" alt="Artwork for @game.Title" />
                        <div class="card-body">
                            <h3 class="h6 card-title mb-1">@game.Title</h3>
                            <p class="text-muted mb-0">@game.DeveloperPublisher · @game.ReleaseYear</p>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-0">No games in the database yet.</p>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
