@model Night.ViewModels.MembersPageViewModel
@using Night.Extensions
@{
    ViewData["Title"] = "Collective Members";
}

<div class="container py-5">
    <div class="mb-4">
        <p class="eyebrow mb-2">About the collective</p>
        <h1 class="display-6 fw-bold mb-3">Members & games</h1>
        <p class="lead text-muted">Meet the people behind the collective and explore our game portfolio</p>
    </div>

    <div class="row g-4">
        @foreach (var member in Model.Members)
        {
            <div class="col">
                @switch (member.MembershipType)
                {
                    case Night.Models.MembershipType.Unsubscribed:
                        @await Component.InvokeAsync("UnsubscribedMemberVC", new { member })
                        break;
                    case Night.Models.MembershipType.Subscribed:
                        @await Component.InvokeAsync("SubscribedMemberVC", new { member })
                        break;
                    case Night.Models.MembershipType.Full:
                    default:
                        @await Component.InvokeAsync("CollectiveMemberVC", new { member })
                        break;
                }
            </div>
        }
    </div>
</div>

<section class="mb-5" aria-labelledby="games-gallery-heading">
    <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
        <div>
            <p class="eyebrow mb-1">Gallery</p>
            <h2 id="games-gallery-heading" class="h3 mb-0">Games</h2>
        </div>
    </div>
    @if (Model.Games.Any())
    {
        <div class="row g-4">
            @foreach (var game in Model.Games)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <article class="card h-100 border-0 overflow-hidden">
                        @await Component.InvokeAsync("ResponsiveImageVC", new
                        {
                            smallUrl = game.ImageSmallUrl,
                            mediumUrl = game.ImageMediumUrl,
                            largeUrl = game.ImageLargeUrl,
                            altText = $"Artwork for {game.Title}",
                            cssClass = "card-img-top",
                            width = 640,
                            height = 360,
                            aspectRatio = "16 / 9"
                        })
                        <div class="card-body">
                            <h3 class="h6 card-title mb-1">@game.Title</h3>
                            <p class="text-muted mb-1">@game.DeveloperPublisher · @game.ReleaseYear</p>
                            @if (game.MemberContributions.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @foreach (var member in game.MemberContributions)
                                    {
                                        var workAreasText = string.Join(", ", member.WorkAreas.Select(wa => wa.GetIconWithName()));
                                        var tooltipText = $"{member.Name} - {member.InvolvementLevel}\n{workAreasText}";
                                        var memberImageUrl = member.ImageSmallUrl ?? member.Image;
                                        <div class="position-relative" title="@tooltipText" data-bs-toggle="tooltip" data-bs-placement="top">
                                            <img class="rounded-circle border" src="@memberImageUrl" alt="@member.Name" width="40" height="40" style="object-fit: cover;" />
                                            <div class="position-absolute bottom-0 end-0 translate-middle-x" style="font-size: 0.9rem;">
                                                @(member.InvolvementLevel switch
                                                {
                                                    Night.Models.InvolvementLevel.Lead => "🥇",
                                                    Night.Models.InvolvementLevel.Major => "🥈",
                                                    Night.Models.InvolvementLevel.Supporting => "🥉",
                                                    _ => ""
                                                })
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">External / non-member game</p>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-0">No games in the database yet.</p>
    }
</section>

@section Scripts {
    <script>
        // Initialize tooltips for member avatars on game cards
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
